# Copie este arquivo para backend/.env e preencha os valores.
#   cp backend/.env.example backend/.env
#
# O .env real nunca é versionado (veja .gitignore na raiz).

# Conexão com o MongoDB.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_URL="mongodb://localhost:27017"

# Nome do banco de dados usado pela loja.
DB_NAME="app"

# Origens liberadas no CORS, separadas por vírgula. Use "*" em desenvolvimento.
CORS_ORIGINS="*"

# Senha de acesso ao painel administrativo em /admin.
# TROQUE este valor antes de colocar a loja em produção.
ADMIN_PASSWORD="troque-esta-senha"
